## Example backend environment for local development
# Copy this file to backend/.env and fill values (DO NOT COMMIT real secrets)

# Google OAuth 2.0 client ID (Web application) from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of allowed origins for CORS (do NOT use '*'
# when you want to send cookies from the browser).
CORS_ORIGINS=http://localhost:3000

SESSION_TTL=3600
SESSION_COOKIE_NAME=toa_token
COOKIE_SECURE=false
# Copy this file to the project root as `.env` or create an env file with these keys.
# Google OAuth client ID (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of allowed origins for CORS (use specific origins in production)
CORS_ORIGINS=http://localhost:3000

# Session settings
SESSION_TTL=3600
SESSION_COOKIE_NAME=toa_token
COOKIE_SECURE=false
